{
  "reporter": [
    "html",
    "text",
    "text-summary",
    "lcov"
  ],
  "report-dir": "./coverage",
  "temp-dir": "./.nyc_output",
  "sourceMap": false,
  "all": false,
  "include": [
    "server/**/*.js"
  ],
  "exclude": [
    "server/index.js",
    "server/db.js",
    "tests/**",
    "node_modules/**"
  ],
  "check-coverage": true,
  "branches": 80,
  "lines": 80,
  "functions": 80,
  "statements": 80
}
