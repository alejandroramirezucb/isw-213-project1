{
  "reporter": [
    "html",
    "text",
    "text-summary",
    "lcov"
  ],
  "report-dir": "./coverage",
  "temp-dir": "./.nyc_output",
  "sourceMap": false,
  "all": true,
  "include": [
    "cliente/**/*.js"
  ],
  "exclude": [
    "cliente/admin.js",
    "cliente/auth.js",
    "cliente/ayuda.js",
    "cliente/carrito.js",
    "cliente/chofer.js",
    "cliente/historial.js",
    "cliente/main.js",
    "tests/**",
    "node_modules/**",
    "plantillas/**",
    "dist/**",
    "coverage/**"
  ],
  "check-coverage": false,
  "branches": 80,
  "lines": 80,
  "functions": 80,
  "statements": 80
}
