<main class="pagina-autenticacion">
  <div class="tarjeta-autenticacion">
    <h1 class="tarjeta-autenticacion__titulo">Iniciar Sesión</h1>
    <form id="formularioLogin">
      <div class="tarjeta-autenticacion__campo">
        <label class="tarjeta-autenticacion__etiqueta" for="correoLogin">Correo electrónico</label>
        <input type="email" id="correoLogin" class="tarjeta-autenticacion__entrada" placeholder="tu@correo.com" required />
      </div>
      <div class="tarjeta-autenticacion__campo">
        <label class="tarjeta-autenticacion__etiqueta" for="contrasenaLogin">Contraseña</label>
        <input type="password" id="contrasenaLogin" class="tarjeta-autenticacion__entrada" placeholder="Tu contraseña" required />
      </div>
      <button type="submit" class="tarjeta-autenticacion__boton">Iniciar Sesión</button>
    </form>
    <a href="/register" class="tarjeta-autenticacion__enlace">¿No tienes cuenta? Regístrate</a>
  </div>
</main>
