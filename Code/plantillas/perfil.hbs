<main class="contenedor-perfil">
  <div id="perfil-contenido">
    <div class="encabezado-perfil">
      <div class="avatar-ficticio" id="user-avatar">U</div>
      <div class="datos-usuario">
        <h1 id="user-nombre">Cargando...</h1>
        <p id="user-email"></p>
        <p id="user-telefono" style="color: #034e8b; font-weight: 500"></p>
        <p id="user-rol" style="color: #666; font-size: 12px; text-transform: uppercase; font-weight: 700"></p>
      </div>
      <div class="perfil-acciones">
        <button class="btn-logout" id="btn-logout">Cerrar Sesión</button>
      </div>
    </div>

    <div class="seccion-perfil">
      <h2>Mis Pedidos Recientes</h2>
      <div id="lista-pedidos" class="lista-pedidos">
        <p>No tienes pedidos registrados.</p>
      </div>
    </div>
  </div>
</main>
